#!/usr/bin/env python3
"""Count TF frames. The only honest check for two failure modes that look fine
from the topic side: the body TF tree vanishing (rsp's DDS participant never
joined) and the ZED's own 6 frames vanishing while images keep flowing.

`tf2_echo base_link zed_camera_link` reports success during the second one.
Counting does not. Healthy on this robot: ~52 total, exactly 6 zed_*.
"""
import time
import rclpy
from rclpy.node import Node
from tf2_ros import Buffer, TransformListener

rclpy.init()
node = Node("tf_frames")
buffer = Buffer()
TransformListener(buffer, node)
deadline = time.time() + 6.0
while time.time() < deadline:
    rclpy.spin_once(node, timeout_sec=0.2)
names = [line.split(":")[0] for line in buffer.all_frames_as_yaml().splitlines()
         if line and not line.startswith(" ")]
zed = sorted(n for n in names if "zed" in n)
print(f"total {len(names)}  zed {len(zed)}")
print("  " + (", ".join(zed) if zed else "NO zed frames -> "
      "systemctl restart Astrabot_ZED.service"))
if "base_link" not in names:
    print("  NO base_link -> start a second robot_state_publisher; "
          "do NOT restart the controller")
rclpy.shutdown()
raise SystemExit(0 if len(zed) == 6 and "base_link" in names else 1)
