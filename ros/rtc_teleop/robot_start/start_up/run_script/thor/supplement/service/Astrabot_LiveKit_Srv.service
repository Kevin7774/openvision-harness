[Unit]
Description=Astrabot LiveKit SRV (Token Dispatch Server)
Requires=Astrabot_LiveKit.service
After=Astrabot_LiveKit.service
PartOf=Astrabot_Data_Collection.service

[Service]
Type=simple
User=astrabot
WorkingDirectory=/home/astrabot/deploy
EnvironmentFile=-/home/astrabot/deploy/livekit.env
ExecStart=/opt/ros/start_up/run/start_livekit_srv.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
