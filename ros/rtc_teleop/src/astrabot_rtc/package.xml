<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astrabot_rtc</name>
  <version>0.1.0</version>
  <description>Astrabot 端侧通用 RTC 会话、媒体和 DataChannel 公共组件。</description>
  <maintainer email="robot@quantgroup.com">Astrabot Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>libavcodec-dev</depend>
  <depend>libavutil-dev</depend>
  <depend>libswscale-dev</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
