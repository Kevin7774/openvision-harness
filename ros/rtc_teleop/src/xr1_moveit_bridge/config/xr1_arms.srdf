<?xml version="1.0"?>
<robot name="astrabot_xr1_evt2_description">
  <group name="left_arm">
    <chain base_link="base_link" tip_link="left_tcp_link"/>
  </group>
  <group name="right_arm">
    <chain base_link="base_link" tip_link="right_tcp_link"/>
  </group>

  <disable_collisions link1="base_link" link2="platform_link" reason="Adjacent"/>
  <disable_collisions link1="platform_link" link2="head_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="head_yaw_link" link2="head_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="head_pitch_link" link2="zed_camera_link" reason="Adjacent"/>

  <disable_collisions link1="platform_link" link2="left_arm_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_1_link" link2="left_arm_2_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_2_link" link2="left_arm_3_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_3_link" link2="left_arm_4_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_4_link" link2="left_arm_5_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_5_link" link2="left_arm_6_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_6_link" link2="left_arm_7_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_7_link" link2="left_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_gripper_base_link" link2="left_gripper_link" reason="Adjacent"/>
  <disable_collisions link1="left_gripper_base_link" link2="left_arm_camera_link" reason="Adjacent"/>

  <disable_collisions link1="platform_link" link2="right_arm_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_1_link" link2="right_arm_2_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_2_link" link2="right_arm_3_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_3_link" link2="right_arm_4_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_4_link" link2="right_arm_5_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_5_link" link2="right_arm_6_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_6_link" link2="right_arm_7_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_7_link" link2="right_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_gripper_base_link" link2="right_gripper_link" reason="Adjacent"/>
  <disable_collisions link1="right_gripper_base_link" link2="right_arm_camera_link" reason="Adjacent"/>

  <disable_collisions link1="platform_link" link2="front_camera_link" reason="Adjacent"/>
  <disable_collisions link1="platform_link" link2="back_camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_ultrasonic_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="middle_ultrasonic_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_ultrasonic_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="chassis_left_camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="chassis_right_camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="lidar_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="charging_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
</robot>
