<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xr1_moveit_bridge</name>
  <version>0.1.0</version>
  <description>Batch MoveIt 2 collision validation for XR1 Rust grasp candidates.</description>
  <maintainer email="robot@quantgroup.com">Astrabot Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>liboctomap-dev</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>shape_msgs</depend>
  <depend>srdfdom</depend>
  <depend>urdf</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
